# The closure and label dumps are regenerated by g_closure_work.py, g_closure_labels.py and g_labels.py. The one
# exception is kept on purpose: re/LEAVES51.txt is the whole read of the LaunchLocalComputation leaves, which is
# evidence for their classification rather than a report, so it IS tracked.
re/LAUNCH_CLOSURE.txt
re/LABELS51.txt
re/LABELS.md.tmp
re/UNCOVERED_RANKED.md.old

push_retry.ps1
push_retry.log

# one-off generator/helper scripts, never part of the deliverable
re/g_doc*.py
re/_tmp_*.py
re/fix_*.py

# One-off probe/generator scripts under re/ are NOT deliverables. Only the named KEEPERS are
# tracked; everything else matching re/g_*.py is a throwaway and must never enter a commit again.
re/g_*.py
!re/g_coverage.py
!re/g_acceptance.py
!re/g_tu_map.py
!re/g_tu_list.py
!re/g_tu_strings.py
!re/g_fs.py
!re/g_identify.py
!re/g_vtable_slots.py
!re/g_strategy_methods.py
!re/g_run_read.py
# The continuation toolkit for the LaunchLocalComputation objective. Unlike the one-off g_*.py probes these are
# reusable: g_closure_work.py prints a whole closure in work order with the unread leaf bodies, g_closure_labels.py
# prints every function's own string literals, g_callers.py answers the other direction of the graph, and gate.ps1
# is the gate itself. A fresh session cannot continue without them, so they are deliverables.
!re/g_closure_work.py
!re/g_closure_labels.py
!re/g_callers.py
!re/g_domain_closure.py
!re/gate.ps1
# The batch recorders. Each one is the evidence for a batch: the addresses, the bytes, and the reason each was classified
# as it was, in the file rather than in a message that scrolls away. g_add_batch7.py and later are tracked for that reason.
!re/g_note_round529.py
!re/g_add_batch7.py
!re/g_add_batch8.py
!re/g_add_batch9.py
!re/g_add_batch10.py
!re/g_add_batch11.py
!re/g_add_batch12.py

# the local backup archives: large, and the bundle contains the whole history already
/backup/
